# Copy to .env (gitignored) on the host and fill in the values.
#
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, the app serves the
# copyrighted books and the derived flashcards from self-hosted Supabase
# Storage instead of a local ./materials directory. Leave them unset for local
# development against ./materials.

# Supabase gateway as seen from inside the app container. The Supabase stack
# publishes its gateway (envoy) on the host at :8000; the container reaches it
# via host.docker.internal (see extra_hosts in docker-compose.yml).
SUPABASE_URL=http://host.docker.internal:8000

# Service role key from the Supabase deployment's .env (docker/.env).
# Server-side only -- never commit it, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_MATERIALS_BUCKET=cysa-materials
SUPABASE_BOOKS_PREFIX=books
